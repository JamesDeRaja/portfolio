{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "functions": {
    "src/server/api.ts": {
      "runtime": "nodejs18.x"
    }
  },
  "env": {
    "VITE_GEMINI_API_KEY": "@vite_gemini_api_key",
    "VITE_EMAIL_SERVICE": "@vite_email_service",
    "VITE_EMAIL_USER": "@vite_email_user",
    "VITE_EMAIL_PASS": "@vite_email_pass"
  }
}